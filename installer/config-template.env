# ============================================================
# SPORTBETS AI PORTAL - Plantilla de Configuración
# Copia este archivo como .env y completa los valores
# ============================================================

# === SERVIDOR ===
NODE_ENV=production
PORT=5000
DOMAIN=tudominio.com
FRONTEND_URL=https://tudominio.com
CORS_ORIGINS=https://tudominio.com

# === BASE DE DATOS (PostgreSQL) ===
DB_HOST=localhost
DB_PORT=5432
DB_USER=sportbets_user
DB_PASSWORD=CAMBIAR_CONTRASEÑA_SEGURA
DB_NAME=sportbets_db
DB_SSL=false

# === REDIS ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CAMBIAR_CONTRASEÑA_REDIS

# === AUTENTICACIÓN JWT ===
# Generar con: openssl rand -base64 32
JWT_SECRET=CAMBIAR_SECRET_JWT_MUY_LARGO
JWT_EXPIRES=15m
# Generar con: openssl rand -hex 32
ENCRYPTION_KEY=CAMBIAR_CLAVE_ENCRIPTACION_64_CHARS
SESSION_SECRET=CAMBIAR_SESSION_SECRET

# === INTELIGENCIA ARTIFICIAL ===
# Opciones: claude, openai, gemini
IA_PROVIDER=claude
IA_API_KEY=CAMBIAR_API_KEY_IA
# claude-sonnet-4-6 | gpt-4o | gemini-1.5-pro
IA_MODEL=claude-sonnet-4-6

# === API DEPORTES (RapidAPI) ===
SPORTS_API_KEY=CAMBIAR_RAPIDAPI_KEY
SPORTS_API_URL=https://v3.football.api-sports.io

# === EMAIL (SMTP) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu@gmail.com
SMTP_PASSWORD=CONTRASEÑA_APP_GMAIL

# === CONFIGURACIÓN REGIONAL ===
TIMEZONE=America/Bogota

# === CRON JOBS ===
# Sincronización automática de partidos
ENABLE_CRON=true

# === LOGGING ===
LOG_LEVEL=info

# === SSL (producción) ===
SSL_ENABLED=true
SSL_CERT_PATH=/etc/letsencrypt/live/tudominio.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/tudominio.com/privkey.pem
